preboot=
 sspi 0 00;
 ufs init;
 scsi scan;
 load scsi 0#prodnv 0xc0000000 /btmac.txt 0x11;
 mw.b 0xc0000011 0;
 setexpr.s bdaddr *0xc0000000;
 load scsi 0#prodnv 0xc0000000 /wifimac.txt 0x11;
 mw.b 0xc0000011 0;
 setexpr.s wifiaddr *0xc0000000
bootcmd=bootflow scan -lb mmc; bootflow scan -lb scsi
fdt_addr_r=0x9df00000
kernel_addr_r=0x80080000
kernel_comp_addr_r=0xc0000000
kernel_comp_size=0x10000000
ramdisk_addr_r=0xa0000000
stdout=vidconsole
stderr=vidconsole
